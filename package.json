{
  "name": "voice-of-fish",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @voice-of-fish/desktop tauri dev",
    "build": "pnpm --filter @voice-of-fish/desktop tauri build",
    "lint": "pnpm --filter @voice-of-fish/desktop lint",
    "format": "pnpm --filter @voice-of-fish/desktop format",
    "format:check": "pnpm --filter @voice-of-fish/desktop format:check",
    "test": "pnpm test:rust && pnpm test:web",
    "test:web": "pnpm -r test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:e2e": "pnpm --filter @voice-of-fish/desktop test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "apps/desktop/**/*.{ts,tsx}": [
      "pnpm --filter @voice-of-fish/desktop exec eslint --fix"
    ],
    "apps/desktop/**/*.{ts,tsx,json,css,md}": [
      "pnpm --filter @voice-of-fish/desktop exec prettier --write"
    ]
  }
}
